<?xml version="1.0"?>
<robot name="smart_rover">

  <material name="green_metal">
    <color rgba="0.05 0.45 0.25 1.0"/>
  </material>
  <material name="tire_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="caster_grey">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="sensor_glass">
    <color rgba="0.25 0.25 0.25 0.35"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="1.6"/>
      <origin xyz="0 0 0.11"/>
      <inertia ixx="0.02373" ixy="0.0" ixz="0.0"
               iyy="0.03213" iyz="0.0"
               izz="0.03477"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.11"/>
      <geometry>
        <box size="0.46 0.34 0.22"/>
      </geometry>
      <material name="green_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09"/>
      <geometry>
        <box size="0.46 0.34 0.18"/>
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00029" ixy="0.0" ixz="0.0"
               iyy="0.00040" iyz="0.0"
               izz="0.00029"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.14 0.16 0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="12" velocity="12"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00029" ixy="0.0" ixz="0.0"
               iyy="0.00040" iyz="0.0"
               izz="0.00029"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0.14 -0.16 0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="12" velocity="12"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <link name="caster_wheel_link">
    <inertial>
      <mass value="0.12"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00004" ixy="0.0" ixz="0.0"
               iyy="0.00004" iyz="0.0"
               izz="0.00004"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="-0.14 0 0.045" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1" velocity="10"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="laser_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.06 0 0.22" rpy="0 0 0"/>
  </joint>

</robot>
