<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="robot_scene">
    <physics name="default_physics" default="true" type="ode">
      <gravity>0 0 -9.81</gravity>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1.0</ambient>
            <diffuse>0.5 0.5 0.5 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boundary Walls: Arena 8 x 5 meters, height 0.5m, thickness 0.15m -->
    <!-- Entrance on left: y in [1.9, 3.1]; Exit on right: y in [1.9, 3.1] -->

    <model name="wall_top">
      <static>true</static>
      <pose>4.0 5.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.3 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.3 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1.0</ambient>
            <diffuse>0.9 0.3 0.3 1.0</diffuse>
            <specular>0.3 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_bottom">
      <static>true</static>
      <pose>4.0 0.0 0.25 0 0 0</pose>
